    <!-- Every dependency and plugin is a Maven Central release, so no extra
         resolution repositories: each one added here joins the supply-chain
         boundary of EVERY lookup (and stalls clean builds when it is down).
         The halcyon host remains the deploy target below; the HDF Group's
         GitHub Packages repository is scoped to the hdf5-backend-ffm profile. -->
    <distributionManagement>
        <repository>
            <id>halcyon</id>
            <url>https://cursus.bmi.stonybrookmedicine.edu/releases</url>
        </repository>
    </distributionManagement>
