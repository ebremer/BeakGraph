<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.ebremer</groupId>
    <artifactId>BeakGraph</artifactId>
    <name>BeakGraph</name>
    <version>0.18.0</version>
    <packaging>jar</packaging>
   
    <description>Library for creating indexed binary storages for Apache Jena Graphs and Datasets</description>
   
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
   
    <issueManagement>
        <system>github</system>
        <url>https://github.com/ebremer/BeakGraph/issues</url>
    </issueManagement>
   
    <developers>
        <developer>
          <id>ebremer</id>
          <name>Erich Bremer</name>
          <email>erich.bremer@stonybrook.edu</email>
          <roles>
              <role>author</role>
          </roles>
        </developer>
    </developers>
   
    <inceptionYear>2021</inceptionYear>
   
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>25</java.version>
        <exec.mainClass>com.ebremer.beakgraph.cmdline.BeakGraphCLI</exec.mainClass>
        <!-- On every Jena bump re-sync the pins below (log4j, slf4j, caffeine) with
             the ver.* properties of org.apache.jena:jena:<version>'s POM: managed
             versions win over Jena's transitives, so a stale pin silently runs
             Jena on older libraries than it was built against (BG-195). -->
        <jena.version>6.2.0</jena.version>
        <!--<arrow.version>18.3.0</arrow.version>-->
        <!--<jaxb.version>2.4.0-b180830.0359</jaxb.version>-->
        <!--<jetty.version>11.0.26</jetty.version>-->
        <!-- Stable 2.x line: a beta logging backend (3.0.0-beta2) has no place in a
             released library. YAML config support in 2.x comes from log4j-core plus
             jackson-dataformat-yaml/jackson-databind (declared below) - the 3.x-only
             log4j-config-yaml module is not needed and does not exist for 2.x. -->
        <log4j.version>2.26.1</log4j.version>
        <slf4j.version>2.0.18</slf4j.version>
        <jhdf.version>0.13.0</jhdf.version>
        <!-- Native HDF5 (https://github.com/HDFGroup/hdf5) backend versions for the
             com.ebremer.beakgraph.huge writers, which need incremental (chunk-at-a-
             time) dataset writing that jHDF does not yet support. All writer code
             targets the official hdf.hdf5lib.H5 API, which BOTH backends provide;
             selection is a build-time dependency choice (identical class names
             cannot coexist on one classpath). See the hdf5-backend-* profiles:
             the JavaCPP preset (bundled natives, Maven Central) is the default;
             -Dhdf5.ffm=true switches to the HDF Group's own Java 25 FFM bindings.
             The preset bundles natives for linux-x86_64, macosx-x86_64 and
             windows-x86_64 only (no arm64 jars in any published preset as of
             1.14.3-1.5.10); see docs/INSTRUCTIONS.md §1 for the platform matrix. -->
        <hdf5.javacpp.version>1.14.3-1.5.10</hdf5.javacpp.version>
        <hdf5.ffm.version>2.1.1</hdf5.ffm.version>
        <!-- hdf5.ffm.classifier is SET by the OS-detection profiles below (no
             default here: an unrecognised platform must fail the enforcer rule
             in the hdf5-backend-ffm profile, not silently take an x86_64 jar).
             Set it explicitly (-Dhdf5.ffm.classifier=...) to override.
             Published classifiers: linux-x86_64, windows-x86_64, macos-x86_64,
             macos-aarch64 (no linux-aarch64, no windows-aarch64). -->
        <jcommander.version>3.0</jcommander.version>
        <hilbert.ver>0.2.3</hilbert.ver>
        <jts.ver>1.20.0</jts.ver>
        <aircompressor.version>3.6</aircompressor.version>
        <commons.pool.ver>2.13.1</commons.pool.ver>
        <!-- Matches the version Jena 6.2.0 manages (3.2.4); declared explicitly
             because SimpleNodeTable, FCDReader and MultiTypeDictionaryReader use
             Caffeine directly (so don't rely on a transitive dep). -->
        <caffeine.version>3.2.4</caffeine.version>
        <!-- Heap of the native-image BUILDER JVM (-Pcmdlinenative): the analysis
             of Jena + Fuseki + jHDF needs tens of GB; override with
             -Dnative.build.heap=12G on smaller machines (slower, may fail). -->
        <native.build.heap>32G</native.build.heap>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-shade-plugin.version>3.6.1</maven-shade-plugin.version>
        <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
        <native-maven-plugin.version>1.1.8</native-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.ejml</groupId>
                <artifactId>ejml-simple</artifactId>
                <version>0.46.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j2-impl</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-pool2</artifactId>
                <version>${commons.pool.ver}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <!-- Nothing here calls these three; they are pinned ONLY so the
                 dependencyConvergence rule (lib profile) sees one version across
                 Jena's transitive graph (commons-csv, commons-compress and
                 commons-fileupload2 ask for older ones). Kept at the versions
                 Jena 6.2.0 manages: re-sync on every Jena bump (BG-195). -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.20.0</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.22.0</version>
            </dependency>
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>6.1.0</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>2.21.1</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.21.1</version>
            </dependency>
            <dependency>
                <groupId>io.airlift</groupId>
                <artifactId>aircompressor-v3</artifactId>
                <version>${aircompressor.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
   
    <build>
        <resources>
            <!-- Filter only the version properties file (so Params reads the POM version);
                 everything else (images, yasgui, log4j config, ...) is copied verbatim. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>beakgraph-version.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>beakgraph-version.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Xmx2g</argLine>
                    <!-- A hung test (a deadlocked reader path under ConcurrentReadTest,
                         a loopback server that never answers) used to block CI until
                         the 6-hour job limit. The fork is killed well before that;
                         src/test/resources/junit-platform.properties adds the
                         per-method timeout that names the culprit first. -->
                    <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
                    <!-- One fork, sequential: tests that mutate JVM-global state are
                         marked @Isolated (see src/test/resources/junit-platform.properties). -->
                </configuration>
            </plugin>
        </plugins>
     </build>
    <profiles>
        <profile>
            <id>lib</id>
            <activation>
                <!-- Was activeByDefault, which Maven silently DISABLES whenever any
                     other profile in this POM activates - and the hdf5-backend-*
                     profiles below auto-activate on every build. Property-based
                     "active unless -Dthin" keeps lib on in all builds regardless of
                     other profiles. Consequences: lib now also stays active with
                     -Pcmdlinejar (its shade execution merges with lib's identical
                     one, so the jar is shaded once, same output as before) and with
                     -Pcmdlinenative (pass -Dthin there to skip shading if the
                     native-image build should see plain classes + thin deps). -->
                <property>
                    <name>!thin</name>
                </property>
            </activation>
            <build>
                <finalName>BeakGraph-${project.version}</finalName>
                <plugins>
                    <!-- DELIBERATELY self-contained: the published BeakGraph jar must run
                         with nothing else on the classpath (owner decision - consumers get
                         one jar, dependencies, logging config and all). The trade-off is
                         recorded in README.md, "Design decisions": a consumer that ALSO
                         brings its own Jena/JTS sees duplicate (unrelocated) classes, and
                         the embedded log4j2.yml at the classpath root takes over that
                         app's logging (-Dthin skips the shading). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>${maven-shade-plugin.version}</version>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.ebremer.beakgraph.cmdline.BeakGraphCLI</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                </excludes>
                            </filter>
                        </filters>
                        </configuration>
                        <executions>
                            <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>enforce</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <banDuplicatePomDependencyVersions/>
                                        <dependencyConvergence/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cmdlinenative</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>beakgraph</imageName>
                            <mainClass>com.ebremer.beakgraph.cmdline.BeakGraphCLI</mainClass>
                            <debug>true</debug>
                            <skipNativeTests>true</skipNativeTests>
                            <verbose>true</verbose>
                            <buildArgs>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>                           
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--enable-url-protocols=https</buildArg>
                                <buildArg>-H:+AddAllCharsets</buildArg>
                                <!-- -march=native tunes the binary to the BUILD machine's CPU:
                                     fastest when run where it was built, but it can die with
                                     illegal-instruction errors on older or different CPUs.
                                     Switch to -march=compatibility for distributable binaries. -->
                                <buildArg>-march=native</buildArg>
                                <!-- Builder JVM heap: see the native.build.heap property. -->
                                <buildArg>-J-Xmx${native.build.heap}</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/sparql/.*</buildArg>
                                <buildArg>-H:IncludeResources=beakgraph.png</buildArg>
                                <buildArg>-H:IncludeResources=beakgraph-version.properties</buildArg>
                                <buildArg>-H:IncludeResources=log4j2.yml</buildArg>
                                <buildArg>-H:IncludeResources=META-INF/services/.*</buildArg>
                                <buildArg>-H:IncludeResourceBundles=org.apache.jena.ext.xerces.impl.msg.XMLSchemaMessages</buildArg>
                                <buildArg>-H:IncludeResourceBundles=org.apache.jena.ext.xerces.impl.msg.XMLMessages</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>--link-at-build-time=com.ebremer.beakgraph</buildArg>
                                <buildArg>--future-defaults=all</buildArg>
                                <!-- No -R:MaxHeapSize: a baked-in cap (it was 4g) silently
                                     starved the in-memory engines, which hold the whole
                                     input on the heap. The binary takes Substrate VM's
                                     default (a fraction of physical RAM); users raise it
                                     per run with -XX:MaxHeapSize=16g (docs/INSTRUCTIONS.md §7). -->
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cmdlinejar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>${maven-shade-plugin.version}</version>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.ebremer.beakgraph.cmdline.BeakGraphCLI</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                </excludes>
                            </filter>
                        </filters>
                        </configuration>
                        <executions>
                            <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ================= Native HDF5 backend selection =================
             The com.ebremer.beakgraph.huge writers call the official
             hdf.hdf5lib.H5 API; the two profiles below choose which jar
             provides it. Property-based activation (not activeByDefault) on
             purpose: activating any -P profile would silently deactivate an
             activeByDefault backend and drop hdf.hdf5lib from the classpath. -->
        <profile>
            <!-- DEFAULT: JavaCPP preset of HDF5 1.14.3. On Maven Central, and the
                 platform jars bundle the C library for linux/macos/windows x86_64,
                 so builds and consumers need no system HDF5 install. Same optional
                 pattern as the log4j backend: consumers are not forced to pull the
                 ~40MB of natives unless they use com.ebremer.beakgraph.huge; the
                 shaded fat jars still package it. -->
            <id>hdf5-backend-javacpp</id>
            <activation>
                <!-- Value-based: -Dhdf5.ffm=false (a parameterised CI matrix, say)
                     must keep THIS backend. A bare presence test treated any value,
                     including false, as opting in to the FFM backend (BG-450). -->
                <property>
                    <name>hdf5.ffm</name>
                    <value>!true</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>hdf5-platform</artifactId>
                    <version>${hdf5.javacpp.version}</version>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- OPT-IN (-Dhdf5.ffm=true): the HDF Group's own Java bindings for HDF5
                 ${hdf5.ffm.version}, using the Java 25 FFM API (no JNI glue). Same
                 hdf.hdf5lib.H5 API SURFACE, not the same implementation: the
                 2.1.x FFM binding ships the typed helpers (H5Awrite_int/_long,
                 H5Dwrite_int/..., 21 methods) as throwing "not implemented yet"
                 stubs, so NativeHdf5File uses only the byte[] entry points
                 (H5Awrite / H5Dwrite with a byte[]), which both bindings
                 implement; NativeHdf5PortabilityTest pins that rule (BG-439).
                 No CI leg builds this profile (it needs a PAT), so after touching
                 NativeHdf5File run NativeHdf5SmokeTest by hand with
                 -Dhdf5.ffm=true on a host with HDF5 2.1.x installed.
                 Two prerequisites, which is why this is not the default:
                 1. GitHub Packages requires authentication even for public
                    artifacts. Add to ~/.m2/settings.xml:
                        <server>
                          <id>github-hdfgroup</id>
                          <username>YOUR_GITHUB_USERNAME</username>
                          <password>PAT with read:packages scope</password>
                        </server>
                 2. The jars do NOT bundle the C library: a matching HDF5 2.1.x
                    shared library must be installed and discoverable at runtime
                    (PATH / LD_LIBRARY_PATH / DYLD_LIBRARY_PATH).
                 The FFM API additionally needs the JVM flag
                 - -enable-native-access=ALL-UNNAMED, which this build already
                 passes (surefire argLine) and stamps into the jar manifests.
                 Swap this profile to the JNI flavor by changing the artifactId to
                 hdf5-java-jni. When the HDF Group publishes to Maven Central,
                 drop the <repositories> block and consider making this the
                 default backend. -->
            <id>hdf5-backend-ffm</id>
            <activation>
                <property>
                    <name>hdf5.ffm</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <!-- BG-441: refuse to resolve a classifier the OS-detection
                         profiles below did not set. Without this an unrecognised
                         platform (linux-aarch64, windows-aarch64) silently took a
                         default x86_64 jar of jextract bindings for another ABI. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>enforce-ffm-classifier</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>hdf5.ffm.classifier</property>
                                            <regex>(linux|windows|macos)-(x86_64|aarch64)</regex>
                                            <regexMessage>hdf5.ffm.classifier must name one of the published hdf5-java-ffm classifiers (linux-x86_64, windows-x86_64, macos-x86_64, macos-aarch64).</regexMessage>
                                            <message>No hdf5-java-ffm classifier is known for this platform (os.name=${os.name}, os.arch=${os.arch}). The HDF Group publishes linux-x86_64, windows-x86_64, macos-x86_64 and macos-aarch64 only; pass -Dhdf5.ffm.classifier=&lt;one of them&gt; deliberately, or build without -Dhdf5.ffm=true.</message>
                                        </requireProperty>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <repositories>
                <repository>
                    <id>github-hdfgroup</id>
                    <name>HDF Group GitHub Packages</name>
                    <url>https://maven.pkg.github.com/HDFGroup/hdf5</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>org.hdfgroup</groupId>
                    <artifactId>hdf5-java-ffm</artifactId>
                    <version>${hdf5.ffm.version}</version>
                    <classifier>${hdf5.ffm.classifier}</classifier>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>
        <!-- OS detection for the FFM platform classifier; inert unless the
             hdf5-backend-ffm profile is active. -->
        <profile>
            <id>hdf5-ffm-windows</id>
            <activation>
                <os><family>windows</family><arch>amd64</arch></os>
            </activation>
            <properties>
                <hdf5.ffm.classifier>windows-x86_64</hdf5.ffm.classifier>
            </properties>
        </profile>
        <profile>
            <id>hdf5-ffm-linux</id>
            <activation>
                <os><name>linux</name><arch>amd64</arch></os>
            </activation>
            <properties>
                <hdf5.ffm.classifier>linux-x86_64</hdf5.ffm.classifier>
            </properties>
        </profile>
        <profile>
            <id>hdf5-ffm-macos-intel</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
            </activation>
            <properties>
                <hdf5.ffm.classifier>macos-x86_64</hdf5.ffm.classifier>
            </properties>
        </profile>
        <profile>
            <id>hdf5-ffm-macos-arm</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties>
                <hdf5.ffm.classifier>macos-aarch64</hdf5.ffm.classifier>
            </properties>
        </profile>
    </profiles>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.ejml</groupId>
            <artifactId>ejml-simple</artifactId>
        </dependency>
        <!-- The log4j backend (and the Jackson modules that exist only to parse its
             YAML config) is the CLI's logging choice, not the library's: main code
             logs through slf4j only. optional=true keeps these out of consumers'
             transitive graphs while the cmdline fat jars still package them. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>me.tongfei</groupId>
            <artifactId>progressbar</artifactId>
            <version>0.10.2</version>
